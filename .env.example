# =============================================================
# KRX 고래 추적기 — 환경변수 설정 예시
# 이 파일을 복사해 .env 로 저장하고 값을 채워주세요.
# Replit에서는 Secrets 탭에 등록하면 자동 로드됩니다.
# =============================================================

# --------------------------------------------------
# KIS (한국투자증권) OpenAPI — 실전투자 앱 기준
# 발급: https://apiportal.koreainvestment.com
#   → 앱 생성 → 앱 키 / 앱 시크릿 복사
# 주의: 분당 1회 토큰 발급 제한 있음
# --------------------------------------------------
KIS_APP_KEY=PSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIS_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 실전투자(PROD) / 모의투자(MOCK) 선택 — 기본값 PROD
# PROD: https://openapi.koreainvestment.com:9443
# MOCK: https://openapivts.koreainvestment.com:29443
KIS_ENV=PROD

# --------------------------------------------------
# DART (금융감독원 전자공시시스템) API
# 발급: https://opendart.fss.or.kr → 개발가이드 → API 신청
# --------------------------------------------------
DART_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------
# Anthropic Claude API (AI 분석 기능)
# 발급: https://console.anthropic.com → API Keys
# Replit AI Integrations 환경에서는 자동 설정됨
# --------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------
# Clerk 인증 (선택 — 미설정 시 게스트 모드로 동작)
# 발급: https://dashboard.clerk.com → 앱 생성 → API Keys
# --------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --------------------------------------------------
# KRX 자동 로그인 (선택 — 미설정 시 기본 공개 API만 사용)
# --------------------------------------------------
# KRX_ID=your_krx_id
# KRX_PW=your_krx_password
